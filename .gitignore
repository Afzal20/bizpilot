invoive_generator-next/
.playwright-mcp/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/settings.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Django / app state
*.sqlite3
db.sqlite3
staticfiles/
media/

# Env & secrets
.env
.envs/.local/.postgres
!backend/.envs/.local/.django
